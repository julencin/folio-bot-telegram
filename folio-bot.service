# El bot de Folio como servicio de la Raspberry: arranca solo y se levanta si se cae.
# Ajusta User y las rutas si tu repo no está en /home/pi/folio.
[Unit]
Description=Folio - bot de Telegram
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/folio
ExecStart=/home/pi/folio/.venv/bin/python -m integraciones.telegram.bot
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
